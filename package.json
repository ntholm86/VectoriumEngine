{
  "name": "vectorium-engine",
  "version": "1.0.0",
  "description": "Vectorium - High-performance WebGL game engine with adaptive quality and object pooling",
  "type": "module",
  "main": "./dist/vectorium.js",
  "module": "./dist/vectorium.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vectorium.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/vectorium.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/vectorium",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "game-engine",
    "webgl",
    "webgl2",
    "canvas",
    "typescript",
    "batch-rendering",
    "object-pooling",
    "adaptive-quality",
    "performance"
  ],
  "author": "Nils Wendelboe Holmager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilswendelboe/vectorium-engine.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "build:demo": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {}
}
